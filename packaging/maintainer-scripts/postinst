#!/bin/sh
# postinst for daemonia (SPEC §4.3). Idempotent.
set -e

case "$1" in
  configure)
    if ! getent group daemonia-web >/dev/null; then
      addgroup --system daemonia-web
    fi
    if ! getent passwd daemonia-web >/dev/null; then
      adduser --system --ingroup daemonia-web --no-create-home \
              --home /nonexistent --shell /usr/sbin/nologin \
              --disabled-login --gecos "Daemonia web dashboard" daemonia-web
    fi

    install -d -m 0700 -o root -g root /var/lib/daemonia-helper
    install -d -m 0700 -o root -g root /var/lib/daemonia-helper/backups
    install -d -m 0700 -o daemonia-web -g daemonia-web /var/lib/daemonia
    install -d -m 0700 -o daemonia-web -g daemonia-web /var/lib/daemonia/tls
    install -d -m 0750 -o root -g adm /var/log/daemonia

    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload >/dev/null || true
      systemctl enable daemonia-helper.service daemonia-web.service >/dev/null || true
      systemctl restart daemonia-helper.service || true
      # A fresh installation starts in setup mode, bound to 127.0.0.1 only.
      systemctl restart daemonia-web.service || true
    fi

    if [ -z "$2" ]; then
      cat <<'EOF'

  Daemonia wurde installiert und läuft im Setup-Modus (nur 127.0.0.1:8443).

  Nächster Schritt – Ersteinrichtung starten:
      sudo daemonia-admin bootstrap

  Anleitung: /usr/share/doc/daemonia/INSTALL.md

EOF
    fi
    ;;
esac

exit 0
