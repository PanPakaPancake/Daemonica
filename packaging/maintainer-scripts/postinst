#!/bin/sh
# postinst for daemonica (SPEC §4.3). Idempotent.
set -e

case "$1" in
  configure)
    if ! getent group daemonica-web >/dev/null; then
      addgroup --system daemonica-web
    fi
    if ! getent passwd daemonica-web >/dev/null; then
      adduser --system --ingroup daemonica-web --no-create-home \
              --home /nonexistent --shell /usr/sbin/nologin \
              --disabled-login --gecos "Daemonica web dashboard" daemonica-web
    fi

    install -d -m 0700 -o root -g root /var/lib/daemonica-helper
    install -d -m 0700 -o root -g root /var/lib/daemonica-helper/backups
    install -d -m 0700 -o daemonica-web -g daemonica-web /var/lib/daemonica
    install -d -m 0700 -o daemonica-web -g daemonica-web /var/lib/daemonica/tls
    install -d -m 0750 -o root -g adm /var/log/daemonica

    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload >/dev/null || true
      systemctl enable daemonica-helper.service daemonica-web.service >/dev/null || true
      systemctl restart daemonica-helper.service || true
      # A fresh installation starts in setup mode, bound to 127.0.0.1 only.
      systemctl restart daemonica-web.service || true
    fi

    if [ -z "$2" ]; then
      cat <<'EOF'

  Daemonica wurde installiert und läuft im Setup-Modus (nur 127.0.0.1:8443).

  Nächster Schritt – Ersteinrichtung starten:
      sudo daemonica-admin bootstrap

  Anleitung: /usr/share/doc/daemonica/INSTALL.md

EOF
    fi
    ;;
esac

exit 0
