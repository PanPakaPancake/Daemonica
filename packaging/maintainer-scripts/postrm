#!/bin/sh
# Data is kept on "remove"; only "purge" deletes it (SPEC §4.3).
set -e
case "$1" in
  purge)
    echo "WARNUNG: daemonia wird vollständig entfernt – Konten, Passkeys, Konfiguration,"
    echo "Backups und das Audit-Log werden gelöscht." >&2
    rm -rf /var/lib/daemonia-helper /var/lib/daemonia /var/log/daemonia
    if getent passwd daemonia-web >/dev/null; then deluser --system daemonia-web >/dev/null || true; fi
    if getent group daemonia-web >/dev/null; then delgroup --system daemonia-web >/dev/null || true; fi
    ;;
  remove)
    echo "Hinweis: Daten unter /var/lib/daemonia* und /var/log/daemonia bleiben erhalten (apt purge daemonia löscht sie)."
    ;;
esac
if [ -d /run/systemd/system ]; then systemctl daemon-reload >/dev/null 2>&1 || true; fi
exit 0
