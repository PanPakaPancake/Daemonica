#!/bin/sh
set -e
case "$1" in
  remove|deconfigure)
    if [ -d /run/systemd/system ]; then
      systemctl stop daemonia-web.service daemonia-helper.service >/dev/null 2>&1 || true
      systemctl disable daemonia-web.service daemonia-helper.service >/dev/null 2>&1 || true
    fi
    ;;
esac
exit 0
