[Unit]
Description=Daemonica privileged helper (Unix sockets only)
Documentation=file:///usr/share/doc/daemonica/README.md
After=local-fs.target dbus.service
Before=daemonica-web.service
# A persistent start failure stops after 5 tries instead of looping every 2 s.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
ExecStart=/usr/bin/daemonica-helper --state-dir /var/lib/daemonica-helper --run-dir /run/daemonica --audit-log /var/log/daemonica/audit.log --web-user daemonica-web
Restart=on-failure
RestartSec=2s
SyslogIdentifier=daemonica-helper

RuntimeDirectory=daemonica
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no
StateDirectory=daemonica-helper
StateDirectoryMode=0700
# No LogsDirectory=: systemd would chown/chmod /var/log/daemonica at every
# start and fail with EPERM on the append-only audit log (chattr +a, DEC-035),
# so the helper could never start again. postinst creates the directory.
UMask=0077

# Hardening (SPEC §3.9, target <= 6.0). Every directive NOT set here is listed
# with its reason in docs/ARCHITECTURE.md ("Hardening exceptions").
# Terminals, jobs, package runs and captures are transient units of their own
# (started through systemd), so none of these limits reach sudo or dpkg there.
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6 AF_PACKET
RestrictNamespaces=yes
SystemCallArchitectures=native
# Denied calls fail with EPERM instead of killing a child program.
SystemCallErrorNumber=EPERM
SystemCallFilter=~@obsolete @debug @cpu-emulation @mount @reboot @raw-io @module @clock @swap
# Capabilities no helper operation or child program needs (M1.8, measured).
CapabilityBoundingSet=~CAP_BPF CAP_IPC_LOCK CAP_SYS_TTY_CONFIG CAP_SYS_BOOT CAP_BLOCK_SUSPEND CAP_LEASE CAP_MKNOD CAP_MAC_ADMIN CAP_MAC_OVERRIDE CAP_SYS_PACCT CAP_AUDIT_CONTROL CAP_AUDIT_READ CAP_WAKE_ALARM CAP_SYS_MODULE CAP_SYS_TIME CAP_SYSLOG CAP_SYS_RAWIO CAP_SYS_CHROOT CAP_SYS_NICE CAP_PERFMON CAP_CHECKPOINT_RESTORE
KeyringMode=private

[Install]
WantedBy=multi-user.target
